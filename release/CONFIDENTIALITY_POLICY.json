{
  "format": "copper-confidentiality-audit-config/v1",
  "maxObjectBytes": 16777216,
  "currentTreeExcludedDirectories": [
    ".git",
    "node_modules",
    "dist",
    "build",
    "coverage",
    ".vite",
    "target",
    "__pycache__"
  ],
  "pathRules": [
    {
      "id": "SECRET-PATH-PRIVATE-KEY",
      "category": "secret",
      "severity": "critical",
      "pattern": "(^|/)(id_(rsa|dsa|ecdsa|ed25519)(\\.pub)?|[^/]*(private|signing)[^/]*\\.(pem|key)|[^/]+\\.(p12|pfx|jks|keystore))$",
      "flags": "i",
      "requiredDisposition": "remove-and-rotate-or-prove-public-only"
    },
    {
      "id": "SECRET-PATH-ENV-CREDENTIALS",
      "category": "secret",
      "severity": "high",
      "pattern": "(^|/)(\\.env($|\\.)|credentials?($|\\.)|secrets?($|\\.)|\\.npmrc$|\\.pypirc$|\\.netrc$)",
      "flags": "i",
      "ignorePatterns": [
        "(^|/)\\.env\\.example$",
        "(^|/)\\.env\\.sample$"
      ],
      "requiredDisposition": "remove-and-rotate-or-document-safe-template"
    },
    {
      "id": "DATA-PATH-BACKUP-EXPORT",
      "category": "customer_data",
      "severity": "critical",
      "pattern": "(^|/)(backups?|dumps?|exports?|database-backups?|customer-exports?)(/|$)|\\.(dump|bak|backup|sql\\.(gz|xz|zst)|tar\\.(gz|xz|zst))$",
      "flags": "i",
      "requiredDisposition": "remove-and-confirm-source-destruction"
    },
    {
      "id": "DATA-PATH-RUNTIME-ASSET",
      "category": "restricted_asset",
      "severity": "high",
      "pattern": "(^|/)(attachments?|uploads?|runtime-data|customer-data)(/|$)",
      "flags": "i",
      "requiredDisposition": "remove-or-prove-synthetic-and-redistributable"
    },
    {
      "id": "PRIVACY-PATH-LOG",
      "category": "log",
      "severity": "high",
      "pattern": "(^|/)(logs?)(/|$)|\\.(log|trace)$",
      "flags": "i",
      "requiredDisposition": "remove-or-prove-synthetic-and-redacted"
    },
    {
      "id": "PRIVACY-PATH-SCREENSHOT-EVIDENCE",
      "category": "restricted_asset",
      "severity": "high",
      "pattern": "(^|/)(screenshots?|acceptance-evidence|private-evidence)(/|$)|(^|/)(screenshot|img[_-]?[0-9]|screen-shot|\u5c4f\u5e55\u5feb\u7167|\u622a\u5c4f)[^/]*\\.(png|jpe?g|heic|webp|pdf)$",
      "flags": "i",
      "requiredDisposition": "remove-or-prove-redacted-and-authorized"
    }
  ],
  "contentRules": [
    {
      "id": "SECRET-CONTENT-PRIVATE-KEY",
      "category": "secret",
      "severity": "critical",
      "pattern": "-----BEGIN (?:RSA |EC |OPENSSH |DSA )?PRIVATE KEY-----",
      "flags": "g",
      "requiredDisposition": "remove-rotate-and-assess-history-rewrite"
    },
    {
      "id": "SECRET-CONTENT-AWS-ACCESS-KEY",
      "category": "secret",
      "severity": "critical",
      "pattern": "\\b(?:AKIA|ASIA)[0-9A-Z]{16}\\b",
      "flags": "g",
      "requiredDisposition": "revoke-remove-and-assess-history-rewrite"
    },
    {
      "id": "SECRET-CONTENT-GITHUB-TOKEN",
      "category": "secret",
      "severity": "critical",
      "pattern": "\\b(?:gh[pousr]_[A-Za-z0-9]{30,}|github_pat_[A-Za-z0-9_]{40,})\\b",
      "flags": "g",
      "requiredDisposition": "revoke-remove-and-assess-history-rewrite"
    },
    {
      "id": "SECRET-CONTENT-BEARER-JWT",
      "category": "secret",
      "severity": "critical",
      "pattern": "\\b(?:Bearer\\s+)?eyJ[A-Za-z0-9_-]{8,}\\.[A-Za-z0-9_-]{8,}\\.[A-Za-z0-9_-]{8,}\\b",
      "flags": "gi",
      "requiredDisposition": "revoke-remove-and-assess-history-rewrite"
    },
    {
      "id": "SECRET-CONTENT-CREDENTIAL-ASSIGNMENT",
      "category": "secret",
      "severity": "high",
      "pattern": "\\b(?:password|passwd|pwd|secret|token|api[_-]?key|access[_-]?key|private[_-]?key)\\b\\s*[:=]\\s*(?:\\\"(?!\\$\\()[^\\\"\\r\\n]{8,}\\\"|'(?!\\$\\()[^'\\r\\n]{8,}'|[A-Za-z0-9+/_=-]{12,})",
      "flags": "gi",
      "ignorePatterns": [
        "secrets\\.",
        "process\\.env",
        "import\\.meta\\.env",
        "\\$\\{",
        "<[^>]+>",
        "(?:change[_-]?me|replace[_-]?me|redacted|placeholder|example|dummy|your[_-])"
      ],
      "requiredDisposition": "rotate-remove-or-prove-placeholder"
    },
    {
      "id": "SECRET-CONTENT-URL-CREDENTIALS",
      "category": "secret",
      "severity": "critical",
      "pattern": "\\b(?:https?|mysql|mariadb|postgres(?:ql)?|redis|mongodb(?:\\+srv)?)://[^\\s/:@]+:[^\\s/@]{4,}@",
      "flags": "gi",
      "requiredDisposition": "rotate-remove-and-assess-history-rewrite"
    },
    {
      "id": "PRIVACY-CONTENT-CN-ID",
      "category": "personal_information",
      "severity": "critical",
      "pattern": "(?<![0-9])[1-9][0-9]{5}(?:18|19|20)[0-9]{2}(?:0[1-9]|1[0-2])(?:0[1-9]|[12][0-9]|3[01])[0-9]{3}[0-9Xx](?![0-9])",
      "flags": "g",
      "requiredDisposition": "remove-or-prove-synthetic-with-evidence"
    },
    {
      "id": "PRIVACY-CONTENT-CN-MOBILE",
      "category": "personal_information",
      "severity": "high",
      "pattern": "(?<![0-9A-Fa-f])1[3-9][0-9]{9}(?![0-9A-Fa-f])",
      "flags": "g",
      "requiredDisposition": "remove-or-prove-synthetic-with-evidence"
    },
    {
      "id": "PRIVACY-CONTENT-EMAIL",
      "category": "personal_information",
      "severity": "medium",
      "pattern": "\\b[A-Z0-9._%+-]+@[A-Z0-9.-]+\\.[A-Z]{2,}\\b",
      "flags": "gi",
      "ignorePatterns": [
        "@example\\.(?:com|org|net)\\b"
      ],
      "requiredDisposition": "remove-or-document-public-role-address"
    },
    {
      "id": "PRIVACY-CONTENT-AUTH-HEADER",
      "category": "secret",
      "severity": "critical",
      "pattern": "\\b(?:(?:authorization|proxy-authorization)\\s*:\\s*(?!<|\\$\\{|redacted|example)(?:Bearer\\s+|Basic\\s+|Token\\s+|[A-Za-z0-9._~+/-]{8,})|(?:cookie|set-cookie)\\s*:\\s*(?!<|\\$\\{|redacted|example)(?:[A-Za-z0-9._-]{1,128}=|\\\"[^\\\"\\r\\n]{8,}\\\"|'[^'\\r\\n]{8,}'))",
      "flags": "gi",
      "ignorePatterns": [
        "\\$\\{",
        "\\$[A-Za-z_]",
        "\\{\\{",
        "<[^>]+>",
        "(?:redacted|placeholder|example|dummy)"
      ],
      "requiredDisposition": "revoke-remove-and-assess-history-rewrite"
    }
  ],
