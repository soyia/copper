# Copper Backend production configuration example. Do not put real secrets in this file.
SPRING_PROFILES_ACTIVE=prod
COPPER_PORT=8191
COPPER_TIME_ZONE=Asia/Shanghai

COPPER_DB_URL=jdbc:mysql://mysql:3306/copper_v2?useSSL=false&useUnicode=true&characterEncoding=UTF-8&serverTimezone=Asia/Shanghai&allowPublicKeyRetrieval=true
COPPER_DB_USERNAME=copper_app
COPPER_DB_PASSWORD_FILE=/run/secrets/copper_db_password
COPPER_FLYWAY_ENABLED=true
COPPER_FLYWAY_BASELINE_ON_MIGRATE=false

COPPER_DATA_ROOT=/app/data
COPPER_FILE_STORAGE_PATH=/app/data/files
COPPER_EXPORT_PATH=/app/data/exports
COPPER_UPLOAD_TEMP_PATH=/app/data/tmp
COPPER_LOG_FILE=/app/data/logs/copper-backend.log
COPPER_LOG_LEVEL=INFO
COPPER_BOOTSTRAP_USERNAME=admin
COPPER_BOOTSTRAP_CREDENTIAL_FILE=/app/data/secrets/initial-admin.txt

# Optional private OCR sidecar. Keep disabled unless the service is deployed.
COPPER_OCR_ENABLED=false
COPPER_OCR_ENDPOINT=http://paddleocr:8080/ocr
COPPER_OCR_ENGINE=PADDLEOCR_LOCAL
COPPER_OCR_MODEL=PP-OCRv6-medium
COPPER_OCR_TIMEOUT_SECONDS=120

COPPER_ALLOWED_ORIGINS=https://copper.example.com
COPPER_ALLOW_PRIVATE_NETWORK_ORIGINS=false
COPPER_COOKIE_SECURE=true
COPPER_COOKIE_SAME_SITE=Strict
