# M4 release-factory security policy. All tool images are immutable multi-architecture manifests.
COPPER_SECURITY_EVIDENCE_FORMAT=copper-security/v1
COPPER_SECURITY_POLICY_VERSION=1
COPPER_SECURITY_DEFAULT_OWNER=product-security-owner
COPPER_SBOM_FORMAT=cyclonedx-json
COPPER_SBOM_SPEC_VERSION=1.6

COPPER_SYFT_VERSION=1.44.0
COPPER_SYFT_IMAGE=docker.io/anchore/syft@sha256:86fde6445b483d902fe011dd9f68c4987dd94e07da1e9edc004e3c2422650de6
COPPER_GRYPE_VERSION=0.112.0
COPPER_GRYPE_IMAGE=docker.io/anchore/grype@sha256:391bfda62888fb4e98ff5c4c81598f7431a3c1eac3f8519d69d1ff00df247c1d
COPPER_GITLEAKS_VERSION=8.30.1
COPPER_GITLEAKS_IMAGE=ghcr.io/gitleaks/gitleaks@sha256:c00b6bd0aeb3071cbcb79009cb16a60dd9e0a7c60e2be9ab65d25e6bc8abbb7f

# Release gates. Critical is always blocking. Stable releases also block unexcepted High issues.
COPPER_RC_BLOCK_SEVERITIES=Critical
COPPER_STABLE_BLOCK_SEVERITIES=Critical,High
COPPER_CRITICAL_FIX_HOURS=72
COPPER_HIGH_FIX_DAYS=14
COPPER_MEDIUM_FIX_DAYS=60
COPPER_LOW_FIX_DAYS=180
COPPER_MAX_EXCEPTION_DAYS=30
COPPER_MAX_CRITICAL_EXCEPTION_DAYS=7
COPPER_GRYPE_DB_MAX_AGE_HOURS=72
