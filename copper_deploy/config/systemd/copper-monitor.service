[Unit]
Description=Copper local availability and recoverability monitor
After=docker.service
ConditionPathExists=/etc/copper/copper.env

[Service]
Type=oneshot
ExecStart=/usr/local/sbin/copperctl monitor check
TimeoutStartSec=4m
Nice=10
IOSchedulingClass=best-effort
IOSchedulingPriority=7
PrivateTmp=true
NoNewPrivileges=true
LogRateLimitIntervalSec=30s
LogRateLimitBurst=200
