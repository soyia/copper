# Stable site identity. Permanent deletion requires this exact value twice.
COPPER_SITE_ID=copper-prod
COPPER_PROJECT_NAME=copper
# Exact Copper Deploy product version currently installed. It is root-protected upgrade identity, not an image tag.
COPPER_RELEASE_VERSION=REPLACE_WITH_INSTALLED_RELEASE_VERSION

# standard: Caddy owns public 80/443 and automatic HTTPS.
# external-proxy: only 127.0.0.1:COPPER_PROXY_PORT is published.
# lan: Caddy binds only to a reserved RFC1918 address and uses a customer-CA certificate.
COPPER_DEPLOY_MODE=standard
COPPER_DOMAIN=copper.example.com
COPPER_TLS_MODE=domain
# IP TLS mode only: place the verified acme.sh archive here before install.
COPPER_ACME_ARCHIVE=/opt/copper/offline/acme.sh-3.1.3.tar.gz
COPPER_PROXY_PORT=8080

# Optional external private OCR engine; false keeps complete manual workflows.
# Enable only after provisioning an independent internal Docker network/service.
# No OCR engine is bundled; see docs/OPTIONAL_OCR.md.
COPPER_OCR_ENABLED=false
COPPER_OCR_ENDPOINT=
COPPER_OCR_NETWORK=
COPPER_OCR_ENGINE=PADDLEOCR_LOCAL
COPPER_OCR_MODEL=PP-OCRv6-medium
COPPER_OCR_TIMEOUT_SECONDS=120

# LAN mode only. Use a customer-controlled DNS A record; .local, hosts files and
# a lone self-signed leaf certificate are not formal multi-user identity.
COPPER_LAN_BIND_IP=192.168.50.20
COPPER_LAN_INTERFACE=ens33
COPPER_LAN_DNS_SERVER=192.168.50.1
COPPER_LAN_ALLOWED_CIDRS=192.168.50.0/24
COPPER_LAN_ADDRESS_RESERVED=no
COPPER_LAN_DOMAIN_CONTROL_CONFIRMED=no
COPPER_LAN_NAME_RESOLUTION=dns

# Optional Internet remote access for LAN deployments. Phase 1 supports only a
# remotely managed Cloudflare Tunnel. Configure it with copperctl; never paste
# the tunnel token into this env file.
COPPER_REMOTE_ACCESS_PROVIDER=none
COPPER_REMOTE_ACCESS_ENABLED=no
# cloudflared 2026.7.2 multi-architecture manifest reviewed on 2026-07-24.
COPPER_CLOUDFLARED_IMAGE=cloudflare/cloudflared@sha256:4f6655284ab3d252b7f28fedb19fe6c8fc82ee5b1295c20ac74d475e5398a52d
COPPER_CLOUDFLARE_HOSTNAME=
COPPER_CLOUDFLARE_TOKEN_FILE=/etc/copper/remote-access/cloudflare/tunnel-token
COPPER_CLOUDFLARE_METRICS_PORT=20241

# Registry delivery uses release @sha256 digests; offline delivery uses the verified image IDs from its bundle.
COPPER_IMAGE_DELIVERY=registry
COPPER_WEB_IMAGE=ghcr.io/soyia/copper_web@sha256:REPLACE_WITH_RELEASE_DIGEST
COPPER_BACKEND_IMAGE=ghcr.io/soyia/copper_backend@sha256:REPLACE_WITH_RELEASE_DIGEST
COPPER_MYSQL_IMAGE=ghcr.io/soyia/copper_mysql@sha256:REPLACE_WITH_RELEASE_DIGEST

COPPER_TIME_ZONE=Asia/Shanghai
COPPER_LOG_LEVEL=INFO
COPPER_BOOTSTRAP_USERNAME=admin

# M1 production paths are fixed. Overrides are accepted only in isolated test mode.
COPPER_ETC_DIR=/etc/copper
COPPER_VAR_DIR=/var/lib/copper
COPPER_BACKUP_DIR=/var/backups/copper
COPPER_RESTORE_ROOT=/var/lib/copper-restores
COPPER_RESTORE_PROXY_PORT=18080

# M2 encrypted backup chain. Store only the customer's public recipient here.
# The matching AGE-SECRET-KEY stays offline with the customer and must never be copied to this server.
COPPER_BACKUP_AGE_RECIPIENT=REPLACE_WITH_CUSTOMER_AGE_RECIPIENT
# ISO weekday 1-7. The scheduled job creates a full base on this day and
# content/binlog increments on the other days. Default 7 means Sunday.
COPPER_BACKUP_FULL_WEEKDAY=7
COPPER_BACKUP_KEEP_DAILY=7
COPPER_BACKUP_KEEP_WEEKLY=4
COPPER_BACKUP_KEEP_MONTHLY=6
COPPER_BACKUP_DAILY_TIME=02:30
COPPER_BACKUP_RANDOM_DELAY_MINUTES=30

# Backup failure/recovery notifications. local keeps durable root-only state and systemd failure status.
# webhook additionally sends a privacy-safe signed JSON event; secrets stay in root-only files.
COPPER_BACKUP_ALERT_MODE=local
COPPER_BACKUP_ALERT_TIMEOUT_SECONDS=10
COPPER_BACKUP_ALERT_WEBHOOK_URL_FILE=/etc/copper/notification-credentials/backup_webhook_url
COPPER_BACKUP_ALERT_HMAC_KEY_FILE=/etc/copper/notification-credentials/backup_webhook_hmac_key

# M4 local application/database/storage/backup/TLS/time monitoring.
# local always keeps root-only status/history and needs no Internet or Copper cloud.
# webhook additionally sends only site fingerprint, levels and fixed action codes.
COPPER_MONITOR_ALERT_MODE=local
COPPER_MONITOR_ALERT_REPEAT_HOURS=24
COPPER_MONITOR_ALERT_TIMEOUT_SECONDS=10
COPPER_MONITOR_ALERT_WEBHOOK_URL_FILE=/etc/copper/notification-credentials/monitor_webhook_url
COPPER_MONITOR_ALERT_HMAC_KEY_FILE=/etc/copper/notification-credentials/monitor_webhook_hmac_key
# external-proxy only: optional root-readable public certificate chain for expiry checks.
# COPPER_MONITOR_TLS_CERT_FILE=/etc/copper/tls/external-fullchain.pem

# M2/M5 backup storage targets. local is always the first recovery copy and may share
# the primary data disk, so it does not replace an independent external/NAS/S3 copy.
# Add external/nas only after mounting and running copperctl storage enroll.
COPPER_BACKUP_TARGETS=local

# External means a customer-managed ext4/xfs/btrfs disk mounted by the operating system.
# The ID is written by storage enroll; do not copy it to a replacement disk by hand.
COPPER_BACKUP_EXTERNAL_DIR=/mnt/copper-external-backups
COPPER_BACKUP_EXTERNAL_ID=

# NAS means an NFS/SMB filesystem already mounted and monitored by the customer OS.
# Copper validates the mount, stable identity, permissions, free space and atomic rename.
# It does not mount NAS shares or store NAS administrator credentials.
COPPER_BACKUP_NAS_DIR=/mnt/copper-backups
COPPER_BACKUP_NAS_ID=

# S3-compatible target. Production endpoints must use HTTPS. Credentials stay in root-only files.
COPPER_BACKUP_S3_ENDPOINT=https://s3.example.com
COPPER_BACKUP_S3_REGION=us-east-1
COPPER_BACKUP_S3_BUCKET=copper-backups
COPPER_BACKUP_S3_PREFIX=copper-prod
COPPER_BACKUP_S3_ACCESS_KEY_FILE=/etc/copper/storage-credentials/s3_access_key
COPPER_BACKUP_S3_SECRET_KEY_FILE=/etc/copper/storage-credentials/s3_secret_key
# Optional temporary credentials only:
# COPPER_BACKUP_S3_SESSION_TOKEN_FILE=/etc/copper/storage-credentials/s3_session_token
