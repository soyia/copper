#!/usr/bin/env python3
"""Guided full-site recovery after a verified backup-then-remove operation."""

from __future__ import annotations

import argparse
import datetime as dt
import importlib.machinery
import importlib.util
import json
import os
import pathlib
import re
import shlex
import stat
import subprocess
import sys
import tempfile
from dataclasses import dataclass


ROOT = pathlib.Path(__file__).resolve().parent
RECOVERY_FORMAT = "copper-guided-disaster-recovery/v1"
RECOVERY_RECEIPT_FORMAT = "copper-guided-disaster-recovery-receipt/v1"
RETIRED_NAME_RE = re.compile(r"^([a-z0-9][a-z0-9-]{2,31})-([0-9]{8}-[0-9]{6})\.json$")
PHASES = {
    "SELECTED",
    "INSTALLED",
    "ADMIN_READY",
    "KEY_READY",
    "STAGED",
    "SWITCHED",
    "POST_RESTORE_PROTECTED",
    "RECOVERED_ROLLBACK_RETAINED",
}
COMPONENT_KEYS = ("webImage", "backendImage", "mysqlImage")


def load_tool(module_name: str, filename: str):
    loader = importlib.machinery.SourceFileLoader(module_name, str(ROOT / filename))
    specification = importlib.util.spec_from_loader(loader.name, loader)
    if specification is None or specification.loader is None:
        raise RuntimeError(f"无法加载 {filename}")
    module = importlib.util.module_from_spec(specification)
    sys.modules[specification.name] = module
    specification.loader.exec_module(module)
    return module


manager = load_tool("copper_recovery_manager", "copper-manage-from-mac")
installer = load_tool("copper_recovery_installer", "copper-install-from-mac")


class RecoveryError(RuntimeError):
    pass


@dataclass(frozen=True)
class Evidence:
    profile_path: pathlib.Path
    profile: dict[str, str]
    stamp: str
    primary: pathlib.Path
    secondary: pathlib.Path
    identity: pathlib.Path
    archive: pathlib.Path
    verification_receipt: pathlib.Path
    uninstall_receipt: pathlib.Path
    backup_id: str
    backup_sha256: str
    verification_sha256: str
    uninstall_sha256: str


def fail(message: str) -> None:
    raise RecoveryError(message)


def private_json(path: pathlib.Path, label: str) -> dict[str, object]:
    try:
        return manager.secure_private_json(path, label)
    except manager.ManagerError as error:
        raise RecoveryError(str(error)) from error


def verify_json_sidecar(path: pathlib.Path, label: str) -> str:
    sidecar = pathlib.Path(str(path) + ".sha256")
    if sidecar.is_symlink() or not sidecar.is_file():
        fail(f"{label}缺少 SHA-256 校验文件：{sidecar}")
    lines = sidecar.read_text(encoding="ascii").splitlines()
    digest = manager.sha256_file(path)
    if lines != [f"{digest}  {path.name}"]:
        fail(f"{label}与 SHA-256 校验文件不一致")
    return digest


def same_file(left: pathlib.Path, right: pathlib.Path, label: str) -> None:
    if right.is_symlink() or not right.is_file() or manager.sha256_file(left) != manager.sha256_file(right):
        fail(f"主位置与第二位置的{label}不一致")


def retired_profiles(site_id: str | None) -> list[pathlib.Path]:
    return manager.retired_profile_paths(site_id)


def select_retired(site_id: str | None) -> pathlib.Path:
    candidates = retired_profiles(site_id)
    if not candidates:
        fail("没有找到已彻底移除的站点记录；只有完成过‘备份并彻底移除’的站点才能从这里恢复")
    if len(candidates) == 1:
        return candidates[0]
    labels: list[str] = []
    for path in candidates:
        profile = manager.secure_profile(path)
        labels.append(f"{profile['siteId']} · 原地址 https://{profile['domain']} · {path.stem[-15:]}")
    return candidates[manager.choose("请选择要恢复的已删除站点", labels) - 1]


def profile_key_directory(
    raw: str,
    site_id: str,
    expected_identity: pathlib.Path | None = None,
) -> pathlib.Path:
    """Resolve one historical duplicated site suffix without hiding damage.

    Guided installer versions before the site-directory normalization fix could
    persist ``.../site-id/site-id`` even though the verified key replica lived
    at ``.../site-id``.  Collapse only that exact repeated suffix and only when
    the parent replica is bound to the primary identity.  A symlink or a nested
    replica carrying another identity remains authoritative and is rejected by
    the normal evidence checks instead of being silently skipped.
    """
    configured = pathlib.Path(raw).expanduser()
    if configured.name == site_id and configured.parent.name == site_id:
        candidate = configured.parent
        candidate_identity = candidate / "copper-age-identity.txt"
        if candidate.is_dir() and not candidate.is_symlink():
            if expected_identity is None and not configured.exists() and not configured.is_symlink():
                return candidate.resolve()
            if (
                expected_identity is not None
                and expected_identity.is_file()
                and not expected_identity.is_symlink()
                and candidate_identity.is_file()
                and not candidate_identity.is_symlink()
                and manager.sha256_file(candidate_identity) == manager.sha256_file(expected_identity)
            ):
                configured_identity = configured / "copper-age-identity.txt"
                if configured.is_symlink() or configured_identity.is_symlink():
                    return configured.resolve()
                if (
                    configured_identity.is_file()
                    and manager.sha256_file(configured_identity) != manager.sha256_file(expected_identity)
                ):
                    return configured.resolve()
                return candidate.resolve()
    return configured.resolve()


def validate_evidence(profile_path: pathlib.Path) -> Evidence:
    match = RETIRED_NAME_RE.fullmatch(profile_path.name)
    if not match:
        fail("停用站点记录文件名不符合安全规则")
    site_id, stamp = match.groups()
    profile = manager.secure_profile(profile_path)
    if profile["siteId"] != site_id:
        fail("停用站点记录与文件名中的站点代号不一致")
    primary = profile_key_directory(profile["primaryKeyDirectory"], site_id)
    identity = primary / "copper-age-identity.txt"
    secondary = profile_key_directory(profile["backupKeyDirectory"], site_id, identity)
    secondary_identity = secondary / "copper-age-identity.txt"
    for path, label in ((identity, "客户恢复私钥"), (secondary_identity, "第二份客户恢复私钥")):
        if path.is_symlink() or not path.is_file() or stat.S_IMODE(path.stat().st_mode) & 0o077:
            fail(f"{label}不存在或权限不安全：{path}")
    same_file(identity, secondary_identity, "客户恢复私钥")

    uninstall = primary / "uninstall-receipts" / f"{site_id}-{stamp}.json"
    document = private_json(uninstall, "卸载回执")
    uninstall_sha = verify_json_sidecar(uninstall, "卸载回执")
    secondary_uninstall = secondary / "uninstall-receipts" / uninstall.name
    secondary_uninstall_sidecar = pathlib.Path(str(secondary_uninstall) + ".sha256")
    same_file(uninstall, secondary_uninstall, "卸载回执")
    same_file(pathlib.Path(str(uninstall) + ".sha256"), secondary_uninstall_sidecar, "卸载回执校验文件")
    if (
        document.get("formatVersion") != manager.REMOVAL_RECEIPT_FORMAT
        or document.get("status") != "INTERNAL_REHEARSAL_ONLY"
        or document.get("result") != "PASSED"
        or document.get("mode") != "BACKUP_THEN_REMOVE"
        or document.get("siteId") != site_id
        or document.get("domain") != profile["domain"]
        or document.get("serverResidueCheck") != "PASSED"
    ):
        fail("卸载回执没有证明该站点完成了受控备份、删除和验空")
    backup = document.get("backup")
    if not isinstance(backup, dict):
        fail("卸载回执缺少整站备份证明")
    filename = str(backup.get("fileName") or "")
    if not manager.BACKUP_RE.fullmatch(filename) or not filename.startswith(site_id + "_"):
        fail("卸载回执中的整站备份文件名不安全")
    archive = (primary / "backups" / filename).resolve()
    if archive.parent != (primary / "backups").resolve() or archive.is_symlink() or not archive.is_file():
        fail("卸载回执指定的整站备份不存在于客户恢复目录")
    manager.verify_sidecar(archive)
    secondary_archive = secondary / "backups" / filename
    manager.verify_sidecar_file(secondary_archive, pathlib.Path(str(secondary_archive) + ".sha256"), filename)
    same_file(archive, secondary_archive, "整站备份")
    verification_path = pathlib.Path(str(backup.get("verificationReceipt") or "")).expanduser().resolve()
    if verification_path.parent != (primary / "backups").resolve():
        fail("卸载回执引用了客户恢复目录之外的离线验证回执")
    verification = private_json(verification_path, "离线验证回执")
    secondary_verification = secondary / "backups" / verification_path.name
    same_file(verification_path, secondary_verification, "离线验证回执")
    backup_id, backup_sha, verification_sha = manager.receipt_backup_fields(verification_path, archive)
    if (
        backup.get("backupId") != backup_id
        or backup.get("sha256") != backup_sha
        or backup.get("verificationReceiptSha256") != verification_sha
        or manager.sha256_file(archive) != backup_sha
        or verification.get("result") != "PASSED"
    ):
        fail("卸载回执、整站备份和离线验证回执没有绑定到同一份数据")
    return Evidence(
        profile_path, profile, stamp, primary, secondary, identity, archive,
        verification_path, uninstall, backup_id, backup_sha, verification_sha, uninstall_sha,
    )


def pending_path(evidence: Evidence) -> pathlib.Path:
    return evidence.primary / "recovery-receipts" / f".{evidence.profile['siteId']}-pending.json"


def write_state(evidence: Evidence, state: dict[str, object]) -> None:
    state.update(
        {
            "formatVersion": RECOVERY_FORMAT,
            "status": "INTERNAL_REHEARSAL_ONLY",
            "siteId": evidence.profile["siteId"],
            "sourceUninstallReceipt": str(evidence.uninstall_receipt),
            "sourceUninstallReceiptSha256": evidence.uninstall_sha256,
            "backupId": evidence.backup_id,
            "backupSha256": evidence.backup_sha256,
            "updatedAt": dt.datetime.now(dt.timezone.utc).isoformat(),
        }
    )
    manager.write_private_json(pending_path(evidence), state)


def load_state(evidence: Evidence) -> dict[str, object] | None:
    path = pending_path(evidence)
    if not path.exists() and not path.is_symlink():
        return None
    state = private_json(path, "未完成的整站恢复记录")
    if (
        state.get("formatVersion") != RECOVERY_FORMAT
        or state.get("status") != "INTERNAL_REHEARSAL_ONLY"
        or state.get("siteId") != evidence.profile["siteId"]
        or state.get("sourceUninstallReceiptSha256") != evidence.uninstall_sha256
        or state.get("backupId") != evidence.backup_id
        or state.get("backupSha256") != evidence.backup_sha256
        or state.get("phase") not in PHASES
    ):
        fail("未完成恢复记录与当前卸载回执或整站备份不一致")
    return state


def target_profile_from_state(state: dict[str, object]) -> dict[str, str]:
    names = ("siteId", "domain", "publicIp", "sshHost", "sshUser", "sshKey")
    values: dict[str, str] = {}
    for name in names:
        value = state.get(name)
        if not isinstance(value, str) or not value:
            fail("未完成恢复记录缺少目标服务器信息")
        values[name] = value
    values["siteId"] = installer.normalize_site_id(values["siteId"])
    values["domain"] = installer.normalize_domain(values["domain"])
    values["publicIp"] = installer.normalize_public_ipv4(values["publicIp"])
    values["sshHost"] = installer.normalize_ssh_host(values["sshHost"])
    values["sshUser"] = installer.normalize_ssh_user(values["sshUser"])
    return values


def collect_target(evidence: Evidence) -> dict[str, str]:
    profile_document = private_json(evidence.profile_path, "停用站点记录")
    same = manager.choose(
        "恢复到哪里？",
        ["恢复到原服务器", "恢复到另一台全新 Ubuntu 服务器"],
    ) == 1
    default_ip = str(profile_document.get("publicIp") or evidence.profile["sshHost"])
    domain = installer.normalize_domain(manager.prompt("恢复后的访问域名", evidence.profile["domain"]))
    public_ip = installer.normalize_public_ipv4(manager.prompt("目标服务器公网 IPv4", default_ip if same else ""))
    ssh_host = installer.normalize_ssh_host(manager.prompt("SSH 服务器地址", evidence.profile["sshHost"] if same else public_ip))
    ssh_user = installer.normalize_ssh_user(manager.prompt("SSH 登录用户名", evidence.profile["sshUser"] if same else "ubuntu"))
    ssh_key = pathlib.Path(manager.prompt("SSH 私钥文件位置", evidence.profile["sshKey"] if same else "")).expanduser().resolve()
    if ssh_key.is_symlink() or not ssh_key.is_file() or stat.S_IMODE(ssh_key.stat().st_mode) & 0o077:
        fail(f"SSH 私钥不存在或权限不安全：{ssh_key}")
    return {
        "siteId": evidence.profile["siteId"],
        "domain": domain,
        "publicIp": public_ip,
        "sshHost": ssh_host,
        "sshUser": ssh_user,
        "sshKey": str(ssh_key),
    }


