def main(argv: list[str] | None = None) -> int:
    parser = argparse.ArgumentParser(description="Copper Mac 本机管理与数据保护入口")
    parser.add_argument(
        "command",
        nargs="?",
        choices=("menu", "admin", "protect", "status", "backup", "restore-rehearsal", "upgrade", "uninstall-preserve", "reactivate", "remove-site", "recover-deleted"),
        default="menu",
    )
    parser.add_argument("--site-id")
    args = parser.parse_args(argv)
    if sys.platform != "darwin":
        fail("本入口当前只支持 Mac；Ubuntu 服务器请运行 sudo copper-maintain")
    if args.command == "recover-deleted":
        return recover_deleted_site(args.site_id)
    if args.command == "menu":
        return home_menu(args.site_id)
    profile_path, profile = select_profile(args.site_id)
    _, primary, secondary, media = require_local_files(profile)
    if args.command == "admin":
        administrator(profile)
    elif args.command in ("protect", "backup"):
        create_download_verify(profile, primary, secondary, media)
    elif args.command == "status":
        show_status(profile)
    elif args.command == "restore-rehearsal":
        restore_rehearsal(profile, primary)
    elif args.command == "upgrade":
        return guided_upgrade(profile)
    elif args.command == "uninstall-preserve":
        preserve_data_uninstall(profile)
    elif args.command == "reactivate":
        reactivate_preserved_site(profile)
    elif args.command == "remove-site":
        backup_then_remove_site(profile_path, profile, primary, secondary, media)
    return 0


if __name__ == "__main__":
    try:
        raise SystemExit(main())
    except KeyboardInterrupt:
        print("\n操作已暂停；未完成记录和数据保护证明均会保留。重新运行同一入口即可继续。", file=sys.stderr)
        raise SystemExit(130)
    except (ManagerError, OSError, subprocess.CalledProcessError, json.JSONDecodeError) as error:
        print(f"\n操作已停止：{error}", file=sys.stderr)
        print("已有数据、密钥和已下载备份不会被删除或覆盖。修正提示后可重新运行同一入口。", file=sys.stderr)
        raise SystemExit(3)
