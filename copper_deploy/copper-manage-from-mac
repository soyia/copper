                "立即创建、下载并离线验证一份备份",
                "做一次不影响正式数据的恢复演练",
                "升级 Copper（自动备份、迁移、切换和失败保护）",
                "停止使用、重新启用或彻底移除站点",
                "从整站备份恢复已删除的站点",
                "退出",
            ],
        )
        if choice == 1:
            administrator(profile)
        elif choice == 2:
            create_download_verify(profile, primary, secondary, media)
        elif choice == 3:
