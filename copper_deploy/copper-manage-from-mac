def pending_restore_path(primary: pathlib.Path, site_id: str) -> pathlib.Path:
    return primary / "restore-rehearsals" / f"{site_id}-pending.json"


def discard_rehearsal(profile: dict[str, str], restore_id: str) -> None:
    if not RESTORE_ID_RE.fullmatch(restore_id):
        fail("待清理的恢复演练编号格式不正确")
    remote(
        profile,
        f"sudo copperctl backup restore discard {shlex.quote(restore_id)} "
        f"--confirm {shlex.quote('DISCARD ' + restore_id)}\n"
        "sudo copperctl monitor check",
        tty=True,
    )


def reconcile_pending_rehearsal(profile: dict[str, str], primary: pathlib.Path) -> bool:
    pending_path = pending_restore_path(primary, profile["siteId"])
    if not pending_path.exists() and not pending_path.is_symlink():
        return True
    pending = secure_private_json(pending_path, "未完成恢复演练记录")
    if pending.get("formatVersion") != PENDING_RESTORE_FORMAT or pending.get("siteId") != profile["siteId"]:
        fail("未完成恢复演练记录与当前站点不一致")
    restore_id = pending.get("restoreId")
    if not isinstance(restore_id, str) or not RESTORE_ID_RE.fullmatch(restore_id):
        fail("未完成恢复演练记录缺少安全的恢复编号")
    status = remote(
        profile,
        f"sudo copperctl backup restore status {shlex.quote(restore_id)} >/dev/null 2>&1",
        check=False,
    )
    if status.returncode == 1:
        pending_path.unlink(missing_ok=True)
        print("上次恢复演练没有服务器残留，已清理本机中断记录。")
        return True
    if status.returncode != 0:
        fail("暂时无法核对上次恢复演练；中断记录已保留，请检查网络后重试")
    print(f"检测到上次保留或中断的恢复演练：{restore_id}")
    if choose("先处理上次恢复演练", ["删除上次旁路恢复（推荐）", "继续保留并返回主菜单"]) != 1:
        print("上次旁路恢复继续保留；为避免端口冲突，本次不再创建新的恢复演练。")
        return False
    discard_rehearsal(profile, restore_id)
    pending_path.unlink(missing_ok=True)
    print("上次旁路恢复已经清理，可以开始新的恢复演练。")
    return True


def restore_rehearsal(profile: dict[str, str], primary: pathlib.Path) -> None:
    if not reconcile_pending_rehearsal(profile, primary):
        return
    backups = sorted((primary / "backups").glob("*.copperbak"), key=lambda path: path.stat().st_mtime, reverse=True)
    if not backups:
        fail("本机还没有已下载的 Copper 备份；请先选择“完成数据保护”或“创建并下载备份”")
    archive = backups[0]
    if not BACKUP_RE.fullmatch(archive.name):
        fail("本地备份文件名不符合安全规则")
    verify_sidecar(archive)
    identity = primary / "copper-age-identity.txt"
    restore_id = "operator-" + dt.datetime.now().strftime("%Y%m%d-%H%M%S")
    pending_path = pending_restore_path(primary, profile["siteId"])
    write_private_json(
        pending_path,
        {
            "formatVersion": PENDING_RESTORE_FORMAT,
            "status": "INTERNAL_REHEARSAL_ONLY",
            "siteId": profile["siteId"],
            "restoreId": restore_id,
            "archive": str(archive),
            "createdAt": dt.datetime.now(dt.timezone.utc).isoformat(),
        },
    )
    volatile = f"/run/copper-{restore_id}-identity.txt"
    remote_input_dir = f".copper-restore-input/{profile['siteId']}"
    remote_archive = f"$HOME/{remote_input_dir}/{archive.name}"
    remote(profile, "test \"$(findmnt -n -o FSTYPE /run)\" = tmpfs")
    cleanup = f"sudo rm -f {shlex.quote(volatile)}\nrm -f \"{remote_archive}\" \"{remote_archive}.sha256\""
    try:
        remote(profile, f"install -d -m 0700 \"$HOME/{remote_input_dir}\"")
        subprocess.run(
            [*scp_base(profile), str(archive), f"{profile['sshUser']}@{profile['sshHost']}:{remote_input_dir}/{archive.name}"],
            check=True,
        )
        subprocess.run(
            [*scp_base(profile), str(archive) + ".sha256", f"{profile['sshUser']}@{profile['sshHost']}:{remote_input_dir}/{archive.name}.sha256"],
            check=True,
        )
        with identity.open("rb") as reader:
            remote(
                profile,
                f"sudo tee {shlex.quote(volatile)} >/dev/null\nsudo chown root:root {shlex.quote(volatile)}\nsudo chmod 0400 {shlex.quote(volatile)}",
                input_bytes=reader.read(),
            )
        command = f"""
cleanup() {{ sudo rm -f {shlex.quote(volatile)}; }}
cleanup_input() {{ rm -f \"{remote_archive}\" \"{remote_archive}.sha256\"; }}
trap 'cleanup; cleanup_input' EXIT HUP INT TERM
sudo copperctl backup restore stage \"{remote_archive}\" --identity {shlex.quote(volatile)} --restore-id {shlex.quote(restore_id)} --port 18080
cleanup
cleanup_input
trap - EXIT HUP INT TERM
sudo copperctl backup restore status {shlex.quote(restore_id)}
curl --fail http://127.0.0.1:18080/readyz
sudo test ! -e {shlex.quote(volatile)}
sudo copperctl monitor check
"""
        remote(profile, command, tty=True)
    finally:
        remote(profile, cleanup, check=False)
    print("\n旁路恢复已经验证，正式站点数据没有修改。")
    if choose("是否立即删除本次旁路恢复？", ["删除旁路恢复（推荐）", "暂时保留，稍后由维护人员处理"]) == 1:
        discard_rehearsal(profile, restore_id)
        pending_path.unlink(missing_ok=True)
    else:
        print("已保存待清理记录；下次进入恢复演练时会先提示处理，不需要维护人员查找命令。")


def write_receipt_copy(path: pathlib.Path, document: dict[str, object]) -> tuple[pathlib.Path, pathlib.Path]:
    path.parent.mkdir(parents=True, mode=0o700, exist_ok=True)
    os.chmod(path.parent, 0o700)
    content = json.dumps(document, ensure_ascii=False, indent=2, sort_keys=True) + "\n"
    sidecar = pathlib.Path(str(path) + ".sha256")
    if path.exists() or path.is_symlink():
        if (
            path.is_symlink()
            or not path.is_file()
            or path.stat().st_uid != os.getuid()
            or stat.S_IMODE(path.stat().st_mode) & 0o077
            or path.read_text(encoding="utf-8") != content
        ):
            fail(f"卸载回执目标已存在且内容不同，拒绝覆盖：{path}")
        expected_sidecar = f"{sha256_file(path)}  {path.name}\n"
        if sidecar.is_symlink() or not sidecar.is_file() or sidecar.read_text(encoding="ascii") != expected_sidecar:
            fail(f"既有卸载回执校验文件不正确：{sidecar}")
        return path, sidecar
    descriptor = os.open(path, os.O_WRONLY | os.O_CREAT | os.O_EXCL, 0o600)
    try:
        with os.fdopen(descriptor, "w", encoding="utf-8") as writer:
            writer.write(content)
            writer.flush()
            os.fsync(writer.fileno())
    except BaseException:
        path.unlink(missing_ok=True)
        raise
    sidecar.write_text(f"{sha256_file(path)}  {path.name}\n", encoding="ascii")
    os.chmod(sidecar, 0o600)
    return path, sidecar


def receipt_backup_fields(receipt: pathlib.Path, archive: pathlib.Path) -> tuple[str, str, str]:
    try:
        document = json.loads(receipt.read_text(encoding="utf-8"))
    except (OSError, json.JSONDecodeError) as error:
        raise ManagerError("离线验证回执无法读取") from error
    backup_id = str(document.get("backupId") or "") if isinstance(document, dict) else ""
    backup_sha = str(document.get("backupSha256") or "") if isinstance(document, dict) else ""
    if (
        document.get("formatVersion") != "copper-key-backup-verification/v1"
        or document.get("result") != "PASSED"
        or not re.fullmatch(r"[0-9a-f]{32}", backup_id)
        or not re.fullmatch(r"[0-9a-f]{64}", backup_sha)
        or backup_sha != sha256_file(archive)
    ):
        fail("离线验证回执与刚下载的整站备份不一致")
    return backup_id, backup_sha, sha256_file(receipt)


def write_private_json(path: pathlib.Path, document: dict[str, object]) -> None:
    path.parent.mkdir(parents=True, mode=0o700, exist_ok=True)
    os.chmod(path.parent, 0o700)
    temporary = path.with_name(f".{path.name}.{os.getpid()}.tmp")
    temporary.unlink(missing_ok=True)
    descriptor = os.open(temporary, os.O_WRONLY | os.O_CREAT | os.O_EXCL, 0o600)
    try:
        with os.fdopen(descriptor, "w", encoding="utf-8") as writer:
            json.dump(document, writer, ensure_ascii=False, indent=2, sort_keys=True)
            writer.write("\n")
            writer.flush()
            os.fsync(writer.fileno())
        os.replace(temporary, path)
    finally:
        temporary.unlink(missing_ok=True)


def secure_private_json(path: pathlib.Path, label: str) -> dict[str, object]:
    if path.is_symlink() or not path.is_file():
        fail(f"{label}不存在或不安全：{path}")
    metadata = path.stat()
    if metadata.st_uid != os.getuid() or stat.S_IMODE(metadata.st_mode) & 0o077 or metadata.st_size > 1024 * 1024:
        fail(f"{label}必须只允许当前用户读取：{path}")
    try:
        document = json.loads(path.read_text(encoding="utf-8"))
    except (OSError, json.JSONDecodeError) as error:
        raise ManagerError(f"{label}无法读取：{path}") from error
    if not isinstance(document, dict):
        fail(f"{label}格式不正确：{path}")
    return document


def pending_removal_path(primary: pathlib.Path, site_id: str) -> pathlib.Path:
    return primary / "uninstall-receipts" / f".{site_id}-pending.json"


def pending_protection(
    pending: dict[str, object],
    profile: dict[str, str],
    primary: pathlib.Path,
    secondary: pathlib.Path,
) -> tuple[ProtectionResult, str, str, str, str]:
    if (
        pending.get("formatVersion") != PENDING_REMOVAL_FORMAT
        or pending.get("status") != "INTERNAL_REHEARSAL_ONLY"
        or pending.get("siteId") != profile["siteId"]
        or pending.get("domain") != profile["domain"]
        or pending.get("phase") not in ("PREPARED", "SERVER_REMOVED")
    ):
        fail("未完成卸载记录与当前站点不一致")
    archive = pathlib.Path(str(pending.get("archive") or "")).expanduser().resolve()
    receipt = pathlib.Path(str(pending.get("verificationReceipt") or "")).expanduser().resolve()
    if archive.parent != (primary / "backups").resolve() or receipt.parent != (primary / "backups").resolve():
        fail("未完成卸载记录引用了客户恢复目录之外的文件")
    if archive.is_symlink() or not archive.is_file() or receipt.is_symlink() or not receipt.is_file():
        fail("未完成卸载所需的备份或离线验证回执已经丢失")
    verify_sidecar(archive)
    secondary_archive = secondary / "backups" / archive.name
    secondary_sidecar = pathlib.Path(str(secondary_archive) + ".sha256")
    verify_sidecar_file(secondary_archive, secondary_sidecar, archive.name)
    if sha256_file(secondary_archive) != sha256_file(archive):
        fail("未完成卸载的两份备份不一致")
    backup_id, backup_sha, receipt_sha = receipt_backup_fields(receipt, archive)
    if (
        pending.get("backupId") != backup_id
        or pending.get("backupSha256") != backup_sha
        or pending.get("receiptSha256") != receipt_sha
    ):
        fail("未完成卸载记录与备份证明不一致")
    stamp = str(pending.get("stamp") or "")
    if not re.fullmatch(r"[0-9]{8}-[0-9]{6}", stamp):
        fail("未完成卸载记录的时间标识不正确")
    return ProtectionResult(archive, receipt), backup_id, backup_sha, receipt_sha, stamp


def probe_remote_removal(profile: dict[str, str]) -> str:
    script = r"""
if sudo test ! -e /etc/copper && sudo test ! -e /var/lib/copper && sudo test ! -e /opt/copper && sudo test ! -e /usr/local/sbin/copper-install; then
  printf '__REMOVED__\n'
elif sudo test -f /etc/copper/copper.env && sudo test -d /var/lib/copper && sudo test -x /usr/local/sbin/copper-install; then
  printf '__PRESENT__\n'
else
  printf '__PARTIAL__\n'
fi
"""
    result = remote(profile, script, capture=True, check=False)
    if result.returncode != 0:
        return "UNREACHABLE"
    lines = (result.stdout or b"").decode("utf-8", errors="replace").splitlines()
    marker = lines[-1].strip() if lines else ""
    return {"__REMOVED__": "REMOVED", "__PRESENT__": "PRESENT", "__PARTIAL__": "PARTIAL"}.get(marker, "UNKNOWN")


