import hashlib
import json
import os
import pathlib
import re
import shlex
import shutil
import stat
import subprocess
import sys
from dataclasses import dataclass


PROFILE_FORMAT = "copper-mac-site-profile/v1"
REMOVAL_RECEIPT_FORMAT = "copper-guided-removal-receipt/v1"
PENDING_REMOVAL_FORMAT = "copper-guided-removal-pending/v1"
PENDING_RESTORE_FORMAT = "copper-guided-restore-pending/v1"
SITE_ID_RE = re.compile(r"^[a-z0-9][a-z0-9-]{2,31}$")
RESTORE_ID_RE = re.compile(r"^operator-[0-9]{8}-[0-9]{6}$")
BACKUP_RE = re.compile(r"^[a-z0-9][a-z0-9-]{2,31}_[0-9TZ]+_[0-9a-f]{32}_(?:manual|scheduled|pre-upgrade)\.copperbak$")
DOMAIN_RE = re.compile(r"^(?:[a-z0-9](?:[a-z0-9-]{0,61}[a-z0-9])?\.)+[a-z0-9](?:[a-z0-9-]{0,61}[a-z0-9])?$")
SSH_HOST_RE = re.compile(r"^[A-Za-z0-9](?:[A-Za-z0-9.-]{0,251}[A-Za-z0-9])?$")
SSH_USER_RE = re.compile(r"^[a-z_][a-z0-9_-]{0,31}$")


class ManagerError(RuntimeError):
    pass


@dataclass(frozen=True)
class ProtectionResult:
    archive: pathlib.Path
    verification_receipt: pathlib.Path


def fail(message: str) -> None:
    raise ManagerError(message)


def choose(question: str, options: list[str]) -> int:
    print(f"\n{question}")
    for index, option in enumerate(options, 1):
        print(f"  {index}. {option}")
    while True:
        answer = input("请选择序号：").strip()
        if answer.isdigit() and 1 <= int(answer) <= len(options):
            return int(answer)
        print("请输入上面显示的序号。")


def prompt(label: str, default: str = "") -> str:
    suffix = f" [{default}]" if default else ""
    value = input(f"{label}{suffix}：").strip()
    return value or default


def sha256_file(path: pathlib.Path) -> str:
    digest = hashlib.sha256()
    with path.open("rb") as reader:
        for block in iter(lambda: reader.read(1024 * 1024), b""):
            digest.update(block)
    return digest.hexdigest()


def secure_profile(path: pathlib.Path) -> dict[str, str]:
    if not path.is_file() or path.is_symlink():
        fail(f"站点记录不存在或不安全：{path}")
    metadata = path.stat()
    if metadata.st_uid != os.getuid() or stat.S_IMODE(metadata.st_mode) & 0o077:
        fail(f"站点记录必须只允许当前用户读取：{path}")
    document = json.loads(path.read_text(encoding="utf-8"))
    if not isinstance(document, dict) or document.get("format") != PROFILE_FORMAT:
        fail(f"站点记录格式不受支持：{path}")
    required = (
        "siteId", "domain", "sshHost", "sshUser", "sshKey",
        "primaryKeyDirectory", "backupKeyDirectory", "mediaRoot",
    )
    result: dict[str, str] = {}
    for name in required:
        value = document.get(name)
        if not isinstance(value, str) or not value:
            fail(f"站点记录缺少 {name}")
        result[name] = value
    if not SITE_ID_RE.fullmatch(result["siteId"]):
        fail("站点代号格式不正确")
    if not DOMAIN_RE.fullmatch(result["domain"]) or not SSH_HOST_RE.fullmatch(result["sshHost"]):
        fail("站点域名或 SSH 地址格式不正确")
    if not SSH_USER_RE.fullmatch(result["sshUser"]):
        fail("SSH 登录用户名格式不正确")
    return result


def profile_root() -> pathlib.Path:
    return pathlib.Path.home() / "Library" / "Application Support" / "Copper Installer" / "sites"


def select_profile(site_id: str | None) -> tuple[pathlib.Path, dict[str, str]]:
    root = profile_root()
    if site_id:
        path = root / f"{site_id}.json"
        return path, secure_profile(path)
    profiles = sorted(path for path in root.glob("*.json") if path.is_file() and not path.is_symlink())
    if not profiles:
        fail("没有找到已完成安装的站点记录；请先运行 ./copper-install-from-mac")
    if len(profiles) == 1:
        return profiles[0], secure_profile(profiles[0])
    labels = []
    documents = []
    for path in profiles:
        document = secure_profile(path)
        documents.append(document)
        labels.append(f"{document['siteId']} · https://{document['domain']}")
    selected = choose("请选择要维护的 Copper 站点", labels) - 1
    return profiles[selected], documents[selected]


def retired_profile_paths(site_id: str | None = None) -> list[pathlib.Path]:
    root = profile_root() / "retired"
    if site_id is not None and not SITE_ID_RE.fullmatch(site_id):
        fail("站点代号格式不正确")
    pattern = f"{site_id}-*.json" if site_id else "*.json"
    return sorted(
        (path for path in root.glob(pattern) if path.is_file() and not path.is_symlink()),
        key=lambda path: path.name,
        reverse=True,
    )


def retired_site_ids() -> list[str]:
    """Return each safely recorded deleted site once for the home menu."""
    site_ids: set[str] = set()
    for path in retired_profile_paths():
        site_ids.add(secure_profile(path)["siteId"])
    return sorted(site_ids)


def recover_deleted_site(site_id: str | None = None) -> int:
    retired = retired_profile_paths(site_id)
    if not retired:
        fail("没有找到已彻底移除且保留了完整恢复证明的站点记录")
    recovery = pathlib.Path(__file__).resolve().parent / "copper-recover-from-mac"
    if not recovery.is_file() or recovery.is_symlink() or not os.access(recovery, os.X_OK):
        fail(f"当前安装介质缺少灾难恢复入口：{recovery}")
    command = [str(recovery)]
    if site_id:
        command.extend(("--site-id", site_id))
    return subprocess.run(command, check=False).returncode


def global_menu(site_id: str | None = None) -> int:
    deleted_sites = retired_site_ids()
    if not deleted_sites:
        fail("没有找到正在使用或已删除且可恢复的 Copper 站点记录")
    options = [f"已删除，可从整站备份恢复：{deleted_site}" for deleted_site in deleted_sites]
    options.append("退出")
    choice = choose("当前没有正在使用的 Copper 站点", options)
    if choice <= len(deleted_sites):
        return recover_deleted_site(deleted_sites[choice - 1])
    return 0


def home_menu(site_id: str | None = None) -> int:
    """Show active and recoverable deleted sites at the same top level."""
    if site_id:
        profile_path, profile = select_profile(site_id)
        _, primary, secondary, media = require_local_files(profile)
        return menu(profile_path, profile, primary, secondary, media)

    active_paths = sorted(
        path for path in profile_root().glob("*.json") if path.is_file() and not path.is_symlink()
    )
    deleted_sites = retired_site_ids()
    if not active_paths:
        return global_menu()

    active_profiles = [secure_profile(path) for path in active_paths]
    if len(active_paths) == 1 and not deleted_sites:
        profile = active_profiles[0]
        _, primary, secondary, media = require_local_files(profile)
        return menu(active_paths[0], profile, primary, secondary, media)

    options = [
        f"正在使用：{profile['siteId']} · https://{profile['domain']}"
        for profile in active_profiles
    ]
    options.extend(
        f"已删除，可从整站备份恢复：{deleted_site}" for deleted_site in deleted_sites
    )
    options.append("退出")
    choice = choose("请选择 Copper 站点或恢复操作", options)
    if choice <= len(active_paths):
        selected = choice - 1
        profile = active_profiles[selected]
        _, primary, secondary, media = require_local_files(profile)
        return menu(active_paths[selected], profile, primary, secondary, media)
    deleted_index = choice - len(active_paths) - 1
    if deleted_index < len(deleted_sites):
        return recover_deleted_site(deleted_sites[deleted_index])
    return 0


def require_local_files(profile: dict[str, str]) -> tuple[pathlib.Path, pathlib.Path, pathlib.Path, pathlib.Path]:
    ssh_key = pathlib.Path(profile["sshKey"]).expanduser().resolve()
    primary = pathlib.Path(profile["primaryKeyDirectory"]).expanduser().resolve()
    secondary = pathlib.Path(profile["backupKeyDirectory"]).expanduser().resolve()
    media = pathlib.Path(profile["mediaRoot"]).expanduser().resolve()
    for path, label in (
        (ssh_key, "SSH 私钥"),
        (primary / "copper-age-identity.txt", "客户恢复私钥"),
        (secondary / "copper-age-identity.txt", "第二份客户恢复私钥"),
    ):
        if not path.is_file() or path.is_symlink():
            fail(f"{label}不存在或不安全：{path}")
    if stat.S_IMODE(ssh_key.stat().st_mode) & 0o077:
        fail(f"SSH 私钥权限过宽，请先执行 chmod 600 {ssh_key}")
    if not (media / "tools/copper-key-offline").is_file():
        fail(f"安装介质已移动或不完整：{media}")
    if sha256_file(primary / "copper-age-identity.txt") != sha256_file(secondary / "copper-age-identity.txt"):
        fail("两份客户恢复私钥不一致，拒绝继续")
    return ssh_key, primary, secondary, media


def ssh_base(profile: dict[str, str], *, tty: bool = False) -> list[str]:
    ssh_key = pathlib.Path(profile["sshKey"]).expanduser().resolve()
    command = [
        "ssh", "-i", str(ssh_key), "-o", "BatchMode=yes",
        "-o", "ConnectTimeout=15", "-o", "ServerAliveInterval=15",
        "-o", "ServerAliveCountMax=3",
    ]
    command.append("-tt" if tty else "-T")
    command.append(f"{profile['sshUser']}@{profile['sshHost']}")
    return command


def remote(
    profile: dict[str, str],
    script: str,
    *,
    tty: bool = False,
    capture: bool = False,
    check: bool = True,
    input_bytes: bytes | None = None,
) -> subprocess.CompletedProcess:
    command = [*ssh_base(profile, tty=tty), "bash", "-lc", shlex.quote("set -Eeuo pipefail\n" + script)]
    return subprocess.run(
        command,
        input=input_bytes,
        stdout=subprocess.PIPE if capture else None,
        stderr=subprocess.PIPE if capture else None,
        check=check,
    )


def scp_base(profile: dict[str, str]) -> list[str]:
    return [
        "scp", "-i", str(pathlib.Path(profile["sshKey"]).expanduser().resolve()),
        "-o", "BatchMode=yes", "-o", "ConnectTimeout=15",
        "-o", "ServerAliveInterval=15", "-o", "ServerAliveCountMax=3",
    ]


def administrator(profile: dict[str, str]) -> None:
    print(f"\n登录地址：https://{profile['domain']}")
    print("授权管理员本人可以在下面的服务器菜单查看一次性密码。")
    remote(profile, "sudo copper-maintain admin", tty=True)
    if choose("是否已经改密并使用新密码重新登录？", ["已经完成，立即复查", "尚未完成，稍后从本菜单继续"]) == 1:
        remote(profile, "sudo copper-maintain admin-check", tty=True)


def guided_upgrade(profile: dict[str, str]) -> int:
    entry = pathlib.Path(__file__).resolve().parent / "copper-upgrade-from-mac"
    if not entry.is_file() or entry.is_symlink() or not os.access(entry, os.X_OK):
        fail(f"当前安装介质缺少一键升级入口：{entry}")
    return subprocess.run([str(entry), "--site-id", profile["siteId"]], check=False).returncode


def remote_key_ready(profile: dict[str, str]) -> bool:
    result = remote(profile, "sudo copperctl backup key status >/dev/null 2>&1", check=False)
    return result.returncode == 0


def register_key(profile: dict[str, str], primary: pathlib.Path) -> None:
    if remote_key_ready(profile):
        print("客户恢复公钥已经登记，本次不会重复登记。")
        return
    mode = choose(
        "本次交接属于哪一种？",
        ["内部演练（明确标记 NOT-FORMAL）", "正式客户交接（需要两名真实人员和签署文件）"],
    )
    default_evidence = primary / "handover-record.json"
    if mode == 1:
        evidence = default_evidence
        customer = prompt("客户确认人", "CUSTOMER-INTERNAL-NOT-FORMAL")
        witness = prompt("复核见证人", "WITNESS-INTERNAL-NOT-FORMAL")
    else:
        evidence = pathlib.Path(prompt("已签署交接文件位置")).expanduser().resolve()
        customer = prompt("客户确认人真实姓名")
        witness = prompt("复核见证人真实姓名")
        if "NOT-FORMAL" in customer.upper() or "NOT-FORMAL" in witness.upper():
            fail("正式交接不能使用演练身份")
    if not evidence.is_file() or evidence.is_symlink():
        fail(f"交接文件不存在或不安全：{evidence}")
    if not customer or not witness or customer.casefold() == witness.casefold():
        fail("客户确认人和复核见证人必须是两名不同人员")
    digest = sha256_file(evidence)
    command = (
        "sudo copperctl backup key register "
        f"--handover-sha256 {shlex.quote(digest)} "
        f"--customer-confirmed-by {shlex.quote(customer)} "
        f"--witness-confirmed-by {shlex.quote(witness)}\n"
        "sudo copperctl backup key audit"
    )
    remote(profile, command, tty=True)
    if mode == 1:
        print("本次只形成内部演练记录，不构成正式客户双人签署。")


def latest_backup_name(profile: dict[str, str]) -> str:
    script = r"""
name="$(sudo find /var/backups/copper -maxdepth 1 -type f -name '*.copperbak' -printf '%T@ %f\n' | sort -n | tail -1 | awk '{print $2}')"
test -n "$name"
printf '%s' "$name"
"""
    result = remote(profile, script, capture=True)
    name = result.stdout.decode("utf-8").strip()
    if not BACKUP_RE.fullmatch(name) or not name.startswith(profile["siteId"] + "_"):
        fail("服务器返回的备份文件名不符合当前站点规则")
    return name


def verify_sidecar(archive: pathlib.Path) -> None:
    sidecar = pathlib.Path(str(archive) + ".sha256")
    verify_sidecar_file(archive, sidecar, archive.name)


def verify_sidecar_file(archive: pathlib.Path, sidecar: pathlib.Path, expected_name: str) -> None:
    if not sidecar.is_file() or sidecar.is_symlink():
        fail(f"缺少校验文件：{sidecar}")
    lines = sidecar.read_text(encoding="ascii").splitlines()
    if len(lines) != 1:
        fail("备份校验文件格式不正确")
    match = re.fullmatch(r"([0-9a-f]{64})  (.+)", lines[0])
    if not match or match.group(2) != expected_name or sha256_file(archive) != match.group(1):
        fail("备份文件与 SHA-256 校验文件不一致")


def copy_checked(source: pathlib.Path, destination: pathlib.Path) -> None:
    destination.parent.mkdir(parents=True, mode=0o700, exist_ok=True)
    os.chmod(destination.parent, 0o700)
    if destination.exists():
        if not destination.is_file() or destination.is_symlink() or sha256_file(destination) != sha256_file(source):
            fail(f"目标已有不同文件，拒绝覆盖：{destination}")
        return
    shutil.copy2(source, destination)
    if sha256_file(destination) != sha256_file(source):
        destination.unlink(missing_ok=True)
        fail(f"复制后校验失败：{destination}")
    os.chmod(destination, 0o600)


def download_backup(
    profile: dict[str, str],
    primary: pathlib.Path,
    secondary: pathlib.Path,
) -> tuple[pathlib.Path, pathlib.Path]:
    name = latest_backup_name(profile)
    remote_dir = f".copper-operator-transfer/{profile['siteId']}"
    remote(profile, f"""
install -d -m 0700 "$HOME/{remote_dir}"
sudo install -o "$(id -un)" -g "$(id -gn)" -m 0600 /var/backups/copper/{shlex.quote(name)} "$HOME/{remote_dir}/{shlex.quote(name)}"
sudo install -o "$(id -un)" -g "$(id -gn)" -m 0600 /var/backups/copper/{shlex.quote(name)}.sha256 "$HOME/{remote_dir}/{shlex.quote(name)}.sha256"
""")
    download_root = primary / "backups"
    download_root.mkdir(parents=True, mode=0o700, exist_ok=True)
    archive = download_root / name
    sidecar = pathlib.Path(str(archive) + ".sha256")
    temporary_archive = download_root / f".{name}.downloading"
    temporary_sidecar = pathlib.Path(str(temporary_archive) + ".sha256")
    temporary_archive.unlink(missing_ok=True)
    temporary_sidecar.unlink(missing_ok=True)
    source = f"{profile['sshUser']}@{profile['sshHost']}:{remote_dir}/"
    try:
        subprocess.run([*scp_base(profile), source + name, str(temporary_archive)], check=True)
        subprocess.run([*scp_base(profile), source + name + ".sha256", str(temporary_sidecar)], check=True)
        os.chmod(temporary_archive, 0o600)
        os.chmod(temporary_sidecar, 0o600)
        verify_sidecar_file(temporary_archive, temporary_sidecar, archive.name)
        copy_checked(temporary_archive, archive)
        copy_checked(temporary_sidecar, sidecar)
        verify_sidecar(archive)
    finally:
        remote(profile, f"rm -f \"$HOME/{remote_dir}/{name}\" \"$HOME/{remote_dir}/{name}.sha256\"", check=False)
        temporary_archive.unlink(missing_ok=True)
        temporary_sidecar.unlink(missing_ok=True)
    copy_checked(archive, secondary / "backups" / archive.name)
    copy_checked(sidecar, secondary / "backups" / sidecar.name)
    print(f"备份已下载并校验：{archive}")
    print(f"第二位置副本：{secondary / 'backups' / archive.name}")
    return archive, sidecar


def offline_verify_and_record(
    profile: dict[str, str],
    primary: pathlib.Path,
    secondary: pathlib.Path,
    media: pathlib.Path,
    archive: pathlib.Path,
    *,
    monitor: bool = True,
) -> pathlib.Path:
    receipt = primary / "backups" / f"{archive.stem}-verification.json"
    if not receipt.exists():
        subprocess.run(
            [
                sys.executable, str(media / "tools/copper-key-offline"), "verify-backup",
                "--identity", str(primary / "copper-age-identity.txt"),
                "--archive", str(archive), "--receipt", str(receipt),
            ],
            check=True,
        )
    os.chmod(receipt, 0o600)
    copy_checked(receipt, secondary / "backups" / receipt.name)
    remote_path = f".copper-operator-receipts/{receipt.name}"
    remote(profile, "install -d -m 0700 \"$HOME/.copper-operator-receipts\"")
    subprocess.run(
        [*scp_base(profile), str(receipt), f"{profile['sshUser']}@{profile['sshHost']}:{remote_path}"],
        check=True,
    )
    command = (
        f"trap 'rm -f \"$HOME/{remote_path}\"' EXIT\n"
        f"sudo copperctl backup key record-restore-test \"$HOME/{remote_path}\"\n"
        "sudo copperctl backup key audit"
    )
    if monitor:
        command += "\nsudo copperctl monitor check"
    remote(profile, command, tty=True)
    return receipt


def create_download_verify(
    profile: dict[str, str],
    primary: pathlib.Path,
    secondary: pathlib.Path,
    media: pathlib.Path,
    *,
    decommission: bool = False,
) -> ProtectionResult:
    register_key(profile, primary)
    print("\n服务器将创建一致性加密整站备份；网页会短暂停止写入。")
    command = "sudo copperctl backup create\nsudo copperctl backup status"
    if decommission:
        command += "\nsudo copperctl stop"
        print("备份完成后站点会保持停止，避免离线验证期间又产生未备份的新数据。")
    remote(profile, command, tty=True)
    archive, _ = download_backup(profile, primary, secondary)
    receipt = offline_verify_and_record(profile, primary, secondary, media, archive, monitor=not decommission)
    if not decommission:
        remote(profile, "sudo copperctl backup schedule install\nsudo copperctl backup schedule status", tty=True)
    print(f"离线验证回执：{receipt}")
    if decommission:
        print("\n数据保护已完成：加密备份、离线验证和第二位置副本均已处理。")
        print("站点当前保持停止；取消彻底移除时程序会自动恢复服务。")
    else:
        print("\n数据保护已完成：加密备份、离线验证、第二位置副本和每日计划均已处理。")
        print("提醒：服务器每天仍先写入本机；如需无人值守的异机复制和异机告警，还要配置 NAS/S3 与通知地址。")
    return ProtectionResult(archive, receipt)


