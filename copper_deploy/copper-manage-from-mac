def assert_remote_site_removed(profile: dict[str, str]) -> None:
    script = r"""
residue=0
for path in /etc/copper /var/lib/copper /var/lib/copper-installer /var/lib/copper-restores /var/backups/copper /opt/copper /usr/local/sbin/copper-install /usr/local/sbin/copperctl /usr/local/sbin/copper-maintain "$HOME/.copper-installer-media" "$HOME/.copper-operator-transfer" "$HOME/.copper-operator-receipts" "$HOME/.copper-restore-input"; do
  if sudo test -e "$path" || sudo test -L "$path"; then
    printf 'RESIDUE:%s\n' "$path"
    residue=1
  fi
done
if sudo docker ps -a --format '{{.Names}} {{.Image}}' | awk 'tolower($0) ~ /copper/ {found=1} END {exit found ? 0 : 1}'; then
  printf 'RESIDUE:containers\n'
  residue=1
fi
if sudo docker image ls --format '{{.Repository}}' | awk 'tolower($0) ~ /^ghcr.io\/soyia\/copper_(web|backend|mysql)$/ {found=1} END {exit found ? 0 : 1}'; then
  printf 'RESIDUE:images\n'
  residue=1
fi
if sudo docker network ls --format '{{.Name}}' | awk 'tolower($0) ~ /^copper([_-]|$)/ {found=1} END {exit found ? 0 : 1}'; then
  printf 'RESIDUE:networks\n'
  residue=1
fi
if systemctl list-unit-files --no-legend | awk '$1 ~ /^copper/ {found=1} END {exit found ? 0 : 1}'; then
  printf 'RESIDUE:systemd\n'
  residue=1
fi
test "$residue" -eq 0
printf '__COPPER_SITE_REMOVED__\n'
"""
    result = remote(profile, script, capture=True, check=False)
    output = (result.stdout or b"").decode("utf-8", errors="replace").strip()
    if result.returncode != 0 or output != "__COPPER_SITE_REMOVED__":
        fail("服务器仍有 Copper 残留，未生成卸载完成回执：" + (output or "未返回验空结果"))


def retire_profile(profile_path: pathlib.Path, site_id: str, stamp: str) -> pathlib.Path:
    retired = profile_path.parent / "retired"
    retired.mkdir(parents=True, mode=0o700, exist_ok=True)
    os.chmod(retired, 0o700)
    destination = retired / f"{site_id}-{stamp}.json"
    if destination.exists() or destination.is_symlink():
        fail(f"已存在同名停用站点记录：{destination}")
    os.replace(profile_path, destination)
    os.chmod(destination, 0o600)
    return destination


