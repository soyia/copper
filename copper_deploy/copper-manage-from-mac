def backup_then_remove_site(
    profile_path: pathlib.Path,
    profile: dict[str, str],
    primary: pathlib.Path,
    secondary: pathlib.Path,
    media: pathlib.Path,
) -> pathlib.Path | None:
    print("\n彻底移除会永久删除服务器上的数据库、图片、配置、本地备份和 Copper 安装程序。")
    print("程序会先创建新整站备份、下载、离线验证并复制到第二位置；任一步失败都不会进入删除。")
    pending_path = pending_removal_path(primary, profile["siteId"])
    if pending_path.exists() or pending_path.is_symlink():
        pending = secure_private_json(pending_path, "未完成卸载记录")
        print("检测到上次未完成的彻底移除；备份、离线验证和第二位置副本将复用，不要求重新输入。")
        if choose("是否继续上次操作？", ["继续上次操作", "暂不处理，保持现场"]) != 1:
            print("已保留未完成记录和服务器现场；下次从同一入口继续。")
            return None
        result, backup_id, backup_sha, verification_sha, stamp = pending_protection(
            pending, profile, primary, secondary
        )
    else:
        if choose("是否继续？", ["继续备份并准备彻底移除", "返回上一级"]) != 1:
            print("已返回，站点未改变。")
            return None
        try:
            result = create_download_verify(profile, primary, secondary, media, decommission=True)
            backup_id, backup_sha, verification_sha = receipt_backup_fields(
                result.verification_receipt, result.archive
            )
            stamp = dt.datetime.now().strftime("%Y%m%d-%H%M%S")
            pending = {
                "formatVersion": PENDING_REMOVAL_FORMAT,
                "status": "INTERNAL_REHEARSAL_ONLY",
                "phase": "PREPARED",
                "siteId": profile["siteId"],
                "domain": profile["domain"],
                "archive": str(result.archive),
                "verificationReceipt": str(result.verification_receipt),
                "backupId": backup_id,
                "backupSha256": backup_sha,
                "receiptSha256": verification_sha,
                "stamp": stamp,
                "preparedAt": dt.datetime.now(dt.timezone.utc).isoformat(),
            }
            write_private_json(pending_path, pending)
        except BaseException:
            remote(
                profile,
                "sudo copperctl up\nsudo copperctl monitor check",
                tty=True,
                check=False,
            )
            raise

    if pending["phase"] == "PREPARED":
        command = server_remove_command(profile, backup_id, backup_sha, verification_sha)
        try:
            remote(profile, command, tty=True)
        except subprocess.CalledProcessError as error:
            remote_state = probe_remote_removal(profile)
            if remote_state == "REMOVED":
                pending["phase"] = "SERVER_REMOVED"
            elif remote_state == "PARTIAL":
                print("服务器已进入受控清理阶段，正在从安全检查点再试一次……")
                remote(profile, command, tty=True)
                pending["phase"] = "SERVER_REMOVED"
            elif remote_state == "PRESENT":
                pending_path.unlink(missing_ok=True)
                remote(
                    profile,
                    "sudo copperctl up\nsudo copperctl monitor check",
                    tty=True,
                    check=False,
                )
                raise ManagerError("服务器尚未开始删除，站点已恢复；下次会重新创建最新备份") from error
            else:
                raise ManagerError(
                    "连接在删除确认后中断，现场和证明均已保留；网络恢复后重新运行同一入口即可继续"
                ) from error
        else:
            pending["phase"] = "SERVER_REMOVED"
        pending["serverRemovedAt"] = dt.datetime.now(dt.timezone.utc).isoformat()
        write_private_json(pending_path, pending)

    cleanup_remote_operator_files(profile)
    assert_remote_site_removed(profile)
    retired_profile = profile_path.parent / "retired" / f"{profile['siteId']}-{stamp}.json"
    document: dict[str, object] = {
        "formatVersion": REMOVAL_RECEIPT_FORMAT,
        "status": "INTERNAL_REHEARSAL_ONLY",
        "result": "PASSED",
        "mode": "BACKUP_THEN_REMOVE",
        "siteId": profile["siteId"],
        "domain": profile["domain"],
        "server": f"{profile['sshUser']}@{profile['sshHost']}",
        "removedAt": dt.datetime.now(dt.timezone.utc).isoformat(),
        "backup": {
            "backupId": backup_id,
            "fileName": result.archive.name,
            "sha256": backup_sha,
            "primaryCopy": str(result.archive),
            "secondaryCopy": str(secondary / "backups" / result.archive.name),
            "verificationReceipt": str(result.verification_receipt),
            "verificationReceiptSha256": verification_sha,
        },
        "retained": {
            "primaryRecoveryKeyDirectory": str(primary),
            "secondaryRecoveryKeyDirectory": str(secondary),
            "retiredSiteProfile": str(retired_profile),
            "operatingSystem": True,
            "docker": True,
            "ssh": True,
            "dns": True,
        },
        "serverResidueCheck": "PASSED",
    }
    receipt_root = primary / "uninstall-receipts"
    receipt, sidecar = write_receipt_copy(receipt_root / f"{profile['siteId']}-{stamp}.json", document)
    copy_checked(receipt, secondary / "uninstall-receipts" / receipt.name)
    copy_checked(sidecar, secondary / "uninstall-receipts" / sidecar.name)
    pending_path.unlink(missing_ok=True)
    actual_retired_profile = retire_profile(profile_path, profile["siteId"], stamp)
    if actual_retired_profile != retired_profile:
        fail("本机站点记录退役位置与卸载回执不一致")
    print("\n站点已经彻底移除，服务器验空通过。")
    print(f"卸载回执：{receipt}")
    print(f"第二位置回执：{secondary / 'uninstall-receipts' / receipt.name}")
    print("客户恢复私钥、两份加密备份、Ubuntu、Docker、SSH 和 DNS 均未删除。")
    return receipt


def removal_menu(
    profile_path: pathlib.Path,
    profile: dict[str, str],
    primary: pathlib.Path,
    secondary: pathlib.Path,
    media: pathlib.Path,
) -> bool:
    choice = choose(
        "停止使用或彻底移除",
        [
            "停止使用，保留全部数据",
            "重新启用已保留数据的站点",
            "创建并离线验证整站备份后，彻底移除站点",
            "返回",
        ],
    )
    if choice == 1:
        preserve_data_uninstall(profile)
    elif choice == 2:
        reactivate_preserved_site(profile)
    elif choice == 3:
        if backup_then_remove_site(profile_path, profile, primary, secondary, media) is not None:
            return True
    return False


