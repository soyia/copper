# Copper product release policy. This file is public, contains no secrets, and is
# consumed by contract tests. Historical M1/M2 tags remain immutable exceptions.
COPPER_VERSION_POLICY=copper-semver-v1
COPPER_RELEASE_MANIFEST_FORMAT=copper-release/v1
COPPER_UPGRADE_MATRIX_FORMAT=copper-upgrade-matrix/v1
COPPER_DELIVERY_FORMAT=copper-delivery/v1
COPPER_DELIVERY_READY_FORMAT=copper-delivery-ready/v1
# Earlier release identities are immutable history. 0.4.0-rc.5 is reserved
# exclusively for the second M7-02 zero-live-support installation rehearsal.
# rc.6 remains immutable rights evidence; rc.7 is the 2026-10-16 source/data
# engineering candidate, scoped by docs/RELEASE_SCOPE_20261016.md.
# rc.8 source/build inputs and failed security package remain immutable history.
# rc.9 frozen metadata and real inputs remain immutable history.
# rc.10 removes unowned mysql-shell caches and requires a new exact build;
# preparation alone never supplies image digests or runtime acceptance evidence.
# rc.10 actual M4/medium and restore-stage failure remain immutable history.
# rc.11 fixes checksum-reader compatibility with producer ./ paths, then requires
# real three-image rebuild, new M4/package and full/incremental restore acceptance.
COPPER_NEXT_CANDIDATE_VERSION=0.4.0-rc.11
COPPER_FIRST_GA_VERSION=1.0.0
COPPER_RELEASE_CHANNELS=rc,stable
COPPER_PLANNED_STABLE_MIN_DAYS=28
COPPER_DIRECT_STABLE_UPGRADE_DEPTH=1
COPPER_DATABASE_MIGRATION_POLICY=flyway-append-only
COPPER_BACKUP_FORMAT=copper-backup/v1
COPPER_EXPORT_FORMAT=copper-export/v1
COPPER_SCHEMA_CHANGE_ROLLBACK=verified-backup-or-retained-sidecar
