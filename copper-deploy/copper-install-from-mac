def save_site_profile(
    path: pathlib.Path,
    answers: InstallAnswers,
    media_root: pathlib.Path,
    primary_key_directory: pathlib.Path,
    backup_key_directory: pathlib.Path,
) -> None:
    if path.is_symlink():
        fail(f"站点维护记录不安全：{path}")
    path.parent.mkdir(parents=True, mode=0o700, exist_ok=True)
    os.chmod(path.parent, 0o700)
    document = {
        "format": PROFILE_FORMAT,
        "installerVersion": INSTALLER_VERSION,
        "siteId": answers.site_id,
        "domain": answers.domain,
        "publicIp": answers.public_ip,
        "sshHost": answers.ssh_host,
        "sshUser": answers.ssh_user,
        "sshKey": str(answers.ssh_key),
        "customerReference": answers.customer_reference,
        "primaryKeyDirectory": str(primary_key_directory),
        "backupKeyDirectory": str(backup_key_directory),
        "mediaRoot": str(media_root),
        "completedAt": dt.datetime.now(dt.timezone.utc).isoformat(),
    }
    descriptor, temporary_name = tempfile.mkstemp(prefix=".site-", dir=path.parent)
    temporary = pathlib.Path(temporary_name)
    try:
        with os.fdopen(descriptor, "w", encoding="utf-8") as writer:
            json.dump(document, writer, ensure_ascii=False, sort_keys=True)
            writer.write("\n")
        os.chmod(temporary, 0o600)
        os.replace(temporary, path)
        os.chmod(path, 0o600)
    finally:
        temporary.unlink(missing_ok=True)


