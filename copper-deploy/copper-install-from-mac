    print(f"第二份私钥目录：{backup_directory}")
    if independent_filesystem is not None:
        print("私钥副本：" + ("位于不同文件系统" if independent_filesystem else "同一文件系统，仅满足内部演练"))
    print("私钥不会写入安装答案、安装介质或服务器。")
    print("=" * 60)


def confirm_install(site_id: str, yes: bool) -> None:
    if yes:
        return
    expected = f"INSTALL {site_id}"
    print("请完整输入下面双引号内的确认文字；双引号本身不用输入：")
    print(f'"{expected}"')
    if input("确认文字：").strip() != expected:
        fail("确认文字不一致；尚未生成密钥或上传文件")


def build_parser() -> argparse.ArgumentParser:
    parser = argparse.ArgumentParser(description="从 Mac 生成恢复密钥、备份私钥并远程安装 Copper")
    parser.add_argument("--domain")
    parser.add_argument("--public-ip")
    parser.add_argument("--site-id")
    parser.add_argument("--ssh-host")
    parser.add_argument("--ssh-user")
    parser.add_argument("--ssh-key")
    parser.add_argument("--customer-reference")
    parser.add_argument(
        "--primary-key-root",
        help="主私钥的上级目录，或已含站点代号的最终目录",
    )
    parser.add_argument(
        "--backup-key-root",
        help="第二份私钥的上级目录，或已含站点代号的最终目录",
    )
    parser.add_argument("--time-zone", default="Asia/Shanghai")
    parser.add_argument("--allow-same-disk-backup", action="store_true")
    parser.add_argument("--yes", action="store_true", help="用于可重复内部验收；必须同时提供所有安装信息")
    parser.add_argument("--dry-run", action="store_true", help="只检查介质、输入、DNS 和 SSH，不生成私钥或上传")
    return parser


def main(argv: list[str] | None = None) -> int:
    args = build_parser().parse_args(argv)
    interactive = not args.yes
    media_root = pathlib.Path(__file__).resolve().parent
    print("Copper Mac 一键远程安装（INTERNAL_REHEARSAL_ONLY）")
    require_local_tools(interactive)
    expected_files = verify_local_media(media_root)
    current_media_identity = media_identity(media_root)
    state_path = resume_state_path()
    answers, resumed = resume_or_collect_answers(args, current_media_identity, state_path)
    values = {"domain": answers.domain, "publicIp": answers.public_ip, "sshHost": answers.ssh_host}
    validate_dns_with_choices(values, interactive)
    if values != {"domain": answers.domain, "publicIp": answers.public_ip, "sshHost": answers.ssh_host}:
        resumed = False
        answers = InstallAnswers(
            answers.site_id,
            values["domain"],
            values["publicIp"],
            values["sshHost"],
            answers.ssh_user,
            answers.ssh_key,
            answers.customer_reference,
            answers.primary_key_root,
            answers.backup_key_root,
            answers.time_zone,
        )
    show_plan(answers)
    if resumed:
        print("已选择继续上次安装，不再重复输入确认文字。")
    else:
        confirm_install(answers.site_id, args.yes)
    if not args.dry_run:
        save_resume_state(state_path, answers, current_media_identity, "confirmed")
    check_remote_access(answers, args.yes)
    check_remote_installation_boundary(answers, media_root)
    if args.dry_run:
        print("检查通过；--dry-run 未生成私钥、未上传文件、未修改服务器。")
        return 0
    save_resume_state(state_path, answers, current_media_identity, "remote-ready")
    recipient, primary, backup, independent = prepare_recovery_keys(
        media_root,
        answers.site_id,
        answers.customer_reference,
        answers.primary_key_root,
        answers.backup_key_root,
        args.allow_same_disk_backup,
        interactive,
    )
    save_resume_state(state_path, answers, current_media_identity, "keys-ready")
    show_plan(answers, independent)
    save_resume_state(state_path, answers, current_media_identity, "uploading")
    result = run_remote_install(answers, media_root, expected_files, recipient)
    if result == 0:
        profile_path = site_profile_path(answers.site_id)
        save_site_profile(profile_path, answers, media_root, primary, backup)
        clear_resume_state(state_path)
        print("\n安装后的固定入口：")
        print(f"  登录地址：https://{answers.domain}")
        print("  继续首次登录和数据保护：./copper-manage-from-mac")
        print(f"  本机站点记录：{profile_path}")
        print("程序会先指导授权管理员改密，再完成备份下载、离线验证和第二位置复制。")
        offer_post_install_guide(media_root, answers.site_id, interactive)
    else:
        save_resume_state(state_path, answers, current_media_identity, "remote-install-paused")
    print("\n客户恢复密钥保存在：")
    print(f"  主副本：{primary}")
    print(f"  第二份：{backup}")
    print("请勿把 copper-age-identity.txt 上传到服务器、聊天或工单。")
    return result


if __name__ == "__main__":
    try:
        raise SystemExit(main())
    except (LocalInstallError, OSError, subprocess.CalledProcessError, json.JSONDecodeError) as error:
        print(f"\n安装已停止：{error}", file=sys.stderr)
        print("已生成的本地密钥不会删除或覆盖；如果已确认安装计划，下次运行会优先询问是否继续。", file=sys.stderr)
        raise SystemExit(3)
