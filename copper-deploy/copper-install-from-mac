def install_answers_from_state(document: dict[str, object]) -> InstallAnswers:
    raw = document.get("answers")
    if not isinstance(raw, dict):
        fail("上次安装记录缺少安装信息")

    def required(name: str) -> str:
        value = raw.get(name)
        if not isinstance(value, str) or not value:
            fail("上次安装记录不完整")
        return value

    ssh_key = pathlib.Path(required("sshKey")).expanduser().resolve()
    if not ssh_key.is_file() or ssh_key.is_symlink():
        fail(f"上次使用的 SSH 私钥已不存在，请恢复该文件后重试：{ssh_key}")
    return InstallAnswers(
        normalize_site_id(required("siteId")),
        normalize_domain(required("domain")),
        normalize_public_ipv4(required("publicIp")),
        normalize_ssh_host(required("sshHost")),
        normalize_ssh_user(required("sshUser")),
        ssh_key,
        normalize_label(required("customerReference"), "客户代号"),
        pathlib.Path(required("primaryKeyRoot")).expanduser().resolve(),
        pathlib.Path(required("backupKeyRoot")).expanduser().resolve(),
        normalize_label(required("timeZone"), "时区"),
    )


def save_resume_state(
    path: pathlib.Path,
    answers: InstallAnswers,
    current_media_identity: str,
    phase: str,
) -> None:
    parent = path.parent
    if path.is_symlink():
        fail(f"安装恢复记录不安全：{path}")
    if parent.exists() and (parent.is_symlink() or not parent.is_dir()):
        fail(f"安装恢复记录目录不安全：{parent}")
    parent.mkdir(parents=True, mode=0o700, exist_ok=True)
    os.chmod(parent, 0o700)
    document = {
        "format": RESUME_FORMAT,
        "installerVersion": INSTALLER_VERSION,
        "mediaIdentity": current_media_identity,
        "status": "IN_PROGRESS",
        "phase": phase,
        "updatedAt": dt.datetime.now(dt.timezone.utc).isoformat(),
        "answers": answers_state_document(answers),
    }
    descriptor, temporary_name = tempfile.mkstemp(prefix=".unfinished-", dir=parent)
    temporary = pathlib.Path(temporary_name)
    try:
        with os.fdopen(descriptor, "w", encoding="utf-8") as writer:
            json.dump(document, writer, ensure_ascii=False, sort_keys=True)
            writer.write("\n")
        os.chmod(temporary, 0o600)
        os.replace(temporary, path)
        os.chmod(path, 0o600)
    finally:
        if temporary.exists():
            temporary.unlink()


def load_resume_state(path: pathlib.Path, current_media_identity: str) -> InstallAnswers | None:
    if path.is_symlink():
        fail(f"安装恢复记录不安全：{path}")
    if not path.exists():
        return None
    if not path.is_file():
        fail(f"安装恢复记录不安全：{path}")
    metadata = path.stat()
    if metadata.st_uid != os.getuid() or stat.S_IMODE(metadata.st_mode) & 0o077:
        fail(f"安装恢复记录权限不安全，请确保只有当前用户可读写：{path}")
    document = json.loads(path.read_text(encoding="utf-8"))
    if not isinstance(document, dict) or document.get("format") != RESUME_FORMAT:
        fail("上次安装记录格式不正确；拒绝自动使用")
    if document.get("status") != "IN_PROGRESS":
        return None
    if document.get("installerVersion") != INSTALLER_VERSION or document.get("mediaIdentity") != current_media_identity:
        print("提示：发现其他版本留下的安装记录；本版本不会混用其上传进度，请重新填写一次。")
        return None
    return install_answers_from_state(document)


def clear_resume_state(path: pathlib.Path) -> None:
    if path.is_symlink():
        fail(f"安装恢复记录不安全，未自动删除：{path}")
    if path.exists():
        if not path.is_file():
            fail(f"安装恢复记录不安全，未自动删除：{path}")
        path.unlink()


def has_explicit_install_answers(args: argparse.Namespace) -> bool:
    return any(
        getattr(args, name)
        for name in (
            "domain",
            "public_ip",
            "site_id",
            "ssh_host",
            "ssh_key",
            "customer_reference",
            "primary_key_root",
            "backup_key_root",
        )
    )


def resume_or_collect_answers(
    args: argparse.Namespace,
    current_media_identity: str,
    state_path: pathlib.Path,
) -> tuple[InstallAnswers, bool]:
    interactive = not args.yes
    previous = None
    if interactive and not has_explicit_install_answers(args):
        previous = load_resume_state(state_path, current_media_identity)
    if previous is None:
        return collect_answers(args), False

    print("\n发现上次中断的 Copper 安装：")
    print(f"  访问域名：{previous.domain}")
    print(f"  服务器：{previous.ssh_user}@{previous.ssh_host}")
    print(f"  站点代号：{previous.site_id}")
    choice = choose("是否继续上次安装？", ["继续上次安装", "重新填写安装信息", "暂时退出"])
    if choice == 1:
        return previous, True
    if choice == 2:
        return collect_answers(args), False
    fail("已保留上次安装记录；下次运行仍可继续")


def run_remote_install(
    answers: InstallAnswers,
    media_root: pathlib.Path,
    expected_files: list[pathlib.Path],
    recipient: str,
) -> int:
    with tempfile.TemporaryDirectory(prefix="copper-mac-install-") as directory:
        temporary = pathlib.Path(directory)
        reusable_archives = remote_reusable_image_archives(answers, media_root)
        staged = stage_verified_media(media_root, expected_files, temporary, reusable_archives)
        current_media_identity = media_identity(staged)
        remote_parent = f".copper-installer-media/{answers.site_id}/{INSTALLER_VERSION}-{current_media_identity}"
        answer_file = temporary / "install-answers.json"
        answer_file.write_text(
            json.dumps(answers_document(answers, recipient), ensure_ascii=False, sort_keys=True) + "\n",
            encoding="utf-8",
        )
        os.chmod(answer_file, 0o600)
        upload_sources = [
            staged / "SHA256SUMS",
            *(
                staged / path.relative_to(media_root)
                for path in expected_files
                if (staged / path.relative_to(media_root)).is_file()
            ),
        ]
        remote_files = [f"{remote_parent}/media/{path.relative_to(staged).as_posix()}" for path in upload_sources]
        remote_files.append(f"{remote_parent}/install-answers.json")
        ensure_remote_directories(
            answers,
            [str(pathlib.PurePosixPath(path).parent) for path in remote_files],
        )
        for local_path, remote_path in zip(upload_sources, remote_files[:-1]):
            upload_file_resumable(answers, local_path, remote_path, local_path.relative_to(staged).as_posix())
        upload_file_resumable(answers, answer_file, remote_files[-1], "安装答案")

        media = remote_home_expression(f"{remote_parent}/media")
        verification = f"cd {media}\nsha256sum -c SHA256SUMS\n"
        for attempt in range(1, TRANSFER_ATTEMPTS + 1):
            if run_remote_script(answers, verification).returncode == 0:
                break
            retry_pause(attempt, "服务器安装文件总校验")
        else:
            fail(f"服务器安装文件连续 {TRANSFER_ATTEMPTS} 次无法完成总校验；文件已保留，可重新运行继续")

    remote_script = f"""set -eu
answers=\"$HOME/{remote_parent}/install-answers.json\"
trap 'rm -f \"$answers\"' EXIT HUP INT TERM
chmod 600 \"$answers\"
cd \"$HOME/{remote_parent}/media\"
sudo ./copper-install install --answers \"$answers\" --yes
"""
    result = subprocess.run(
        [*ssh_base(answers, tty=True), "bash", "-lc", shlex.quote(remote_script)],
        check=False,
    )
    if result.returncode == 0:
        release_version = operator_value(media_root, "COPPER_RELEASE_VERSION")
        expected_site = shlex.quote(answers.site_id)
        expected_domain = shlex.quote(answers.domain)
        expected_release = shlex.quote(release_version)
        verification_script = f"""set -eu
read_env() {{
  sudo awk -F= -v key="$1" '$1 == key {{print substr($0, index($0, "=") + 1); exit}}' /etc/copper/copper.env
}}
test "$(read_env COPPER_SITE_ID)" = {expected_site}
test "$(read_env COPPER_DOMAIN)" = {expected_domain}
test "$(read_env COPPER_RELEASE_VERSION)" = {expected_release}
for entry in copper-install copperctl copper-maintain; do
  sudo test -L "/usr/local/sbin/$entry"
  target="$(sudo readlink -f "/usr/local/sbin/$entry")"
  sudo test -x "$target"
done
sudo copper-install status
sudo copperctl status >/dev/null
for service in mysql backend web; do
  test "$(sudo docker inspect --format '{{{{if .State.Health}}}}{{{{.State.Health.Status}}}}{{{{else}}}}{{{{.State.Status}}}}{{{{end}}}}' "copper-$service-1")" = healthy
done
"""
        verification = run_remote_script(answers, verification_script)
        if verification.returncode != 0:
            print("\n安装程序返回成功，但安装后固定入口、站点身份或三层健康复查未通过。")
            print("本次不会保存站点记录，也不会进入首次登录向导。")
            result = subprocess.CompletedProcess(result.args, verification.returncode or 3)
    else:
        print(f"\n远程安装已停止，退出码：{result.returncode}")
        print(f"安装文件保留在服务器：~/{remote_parent}/media")
    return result.returncode


def collect_answers(args: argparse.Namespace) -> InstallAnswers:
    interactive = not args.yes
    supplied = all((args.domain, args.public_ip, args.ssh_host, args.ssh_user, args.ssh_key))
    if args.yes and not supplied:
        fail("--yes 模式必须同时提供域名、公网 IP、SSH 地址、登录用户名和 SSH 私钥路径")
    domain = normalize_domain(args.domain or prompt("域名或固定公网 IPv4（可粘贴 https:// 地址）"))
    default_site = default_site_id(domain)
    site_id = normalize_site_id(args.site_id or prompt("站点代号", default_site))
    public_ip = normalize_public_ipv4(args.public_ip or prompt("服务器公网 IPv4"))
    ssh_host = normalize_ssh_host(args.ssh_host or prompt("SSH 服务器地址", public_ip))
    ssh_user = normalize_ssh_user(args.ssh_user or prompt("服务器登录用户名", "ubuntu"))
    ssh_key = pathlib.Path(args.ssh_key or prompt("SSH 私钥文件位置")).expanduser().resolve()
    if not ssh_key.is_file() or ssh_key.is_symlink():
        fail(f"SSH 私钥文件不存在或不安全：{ssh_key}")
    customer_reference = normalize_label(args.customer_reference or site_id, "客户代号")
    primary_root = pathlib.Path(
        args.primary_key_root or "~/Documents/Copper-Recovery-Keys"
    ).expanduser().resolve()
    backup_value = args.backup_key_root
    if not backup_value:
        if not interactive:
            fail("--yes 模式必须提供第二份私钥备份目录 --backup-key-root")
        backup_value = prompt(
            "第二份私钥备份位置（可填外接盘上级目录或已含站点代号的最终目录，"
            "例如 /Volumes/USB/Copper-Recovery-Keys）"
        )
    backup_root = pathlib.Path(backup_value).expanduser().resolve()
    time_zone = args.time_zone or "Asia/Shanghai"
    return InstallAnswers(
        site_id,
        domain,
        public_ip,
        ssh_host,
        ssh_user,
        ssh_key,
        customer_reference,
        primary_root,
        backup_root,
        time_zone,
    )


