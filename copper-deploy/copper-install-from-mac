def media_identity(media_root: pathlib.Path) -> str:
    return sha256_file(media_root / "SHA256SUMS")[:16]


def operator_value(media_root: pathlib.Path, key: str) -> str:
    matches: list[str] = []
    for raw in (media_root / "OPERATOR_VALUES.env").read_text(encoding="utf-8").splitlines():
        if raw.startswith(f"{key}="):
            matches.append(raw.split("=", 1)[1])
    if len(matches) != 1 or not matches[0]:
        fail(f"安装介质缺少唯一的 {key}")
    return matches[0]


def remote_reusable_image_archives(
    answers: InstallAnswers,
    media_root: pathlib.Path,
) -> set[pathlib.PurePosixPath]:
    """Return image archives that need not be transferred to this exact host.

    Reuse is content-addressed: an image is eligible only when Docker can read
    the exact imported image ID from the signed medium and reports amd64.  A
    similarly named image, an arbitrary MySQL installation, or a tag alone is
    never enough.
    """
    records: list[tuple[str, pathlib.PurePosixPath, str]] = []
    for role in ("WEB", "BACKEND", "MYSQL"):
        archive_text = operator_value(media_root, f"COPPER_{role}_ARCHIVE")
        archive = pathlib.PurePosixPath(archive_text)
        if archive.is_absolute() or ".." in archive.parts or not archive.parts:
            fail(f"安装介质中的 {role.lower()} 文件路径不安全")
        image_id = operator_value(media_root, f"COPPER_{role}_IMAGE")
        if not re.fullmatch(r"sha256:[0-9a-f]{64}", image_id):
            fail(f"安装介质中的 {role.lower()} 镜像身份不正确")
        records.append((role.lower(), archive, image_id))

    lines = [
        "set -eu",
        "command -v docker >/dev/null 2>&1 || exit 0",
        "sudo -n docker info >/dev/null 2>&1 || exit 0",
    ]
    for role, _archive, image_id in records:
        lines.extend(
            [
                f"observed=$(sudo -n docker image inspect --format '{{{{.Id}}}}|{{{{.Architecture}}}}' {shlex.quote(image_id)} 2>/dev/null || true)",
                f"[ \"$observed\" != {shlex.quote(image_id + '|amd64')} ] || printf '%s\\n' {shlex.quote(role)}",
            ]
        )
    result = run_remote_script(answers, "\n".join(lines) + "\n", capture_output=True)
    if result.returncode != 0:
        print("服务器镜像盘点暂不可用，将按完整安装上传所需运行文件。")
        return set()
    reusable_roles = {line.strip() for line in (result.stdout or "").splitlines() if line.strip()}
    result_paths = {archive for role, archive, _image_id in records if role in reusable_roles}
    for role, archive, _image_id in records:
        if archive in result_paths:
            print(f"{role}：服务器已有完全相同的运行文件，跳过上传。")
        else:
            print(f"{role}：服务器没有完全相同的运行文件，本次需要上传。")
    return result_paths


